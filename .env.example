# Mailchimp Configuration for Vercel
# Add these as Environment Variables in your Vercel project settings

# Get your API key from: https://mailchimp.com/help/about-api-keys/
MAILCHIMP_API_KEY=your_mailchimp_api_key_here

# Your Mailchimp Audience/List ID
# Find it in Audience > Settings > Audience name and defaults
MAILCHIMP_LIST_ID=your_list_id_here

# Your Mailchimp server prefix (e.g., us21, us14, etc.)
# This is the prefix in your Mailchimp API endpoint URL
# You can find it by looking at your Mailchimp URL: https://usXX.admin.mailchimp.com
MAILCHIMP_SERVER_PREFIX=us21
